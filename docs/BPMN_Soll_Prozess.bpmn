    <bpmn:textAnnotation id="TextAnnotation_051dyds">
      <bpmn:text>Mail-Template oder KI-Text</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0n3fr4x" associationDirection="None" sourceRef="Activity_021ninw" targetRef="TextAnnotation_051dyds" />
    <bpmn:textAnnotation id="TextAnnotation_18f3b22">
      <bpmn:text>Keine manuelle Eskalation mehr; die Entscheidung wird mit Begründung am Prozessende verschickt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0w3yvhx" associationDirection="None" sourceRef="Activity_1hwdhah" targetRef="TextAnnotation_18f3b22" />
    <bpmn:textAnnotation id="TextAnnotation_16isx59">
      <bpmn:text>KI-geschrieben oder Template</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_192x8gm" associationDirection="None" sourceRef="Activity_0dj8zcg" targetRef="TextAnnotation_16isx59" />
    <bpmn:textAnnotation id="TextAnnotation_1t3s9r9">
      <bpmn:text>Mittels Prüfliste, statt nur drei Zustandskriterien</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sb3q06">
      <bpmn:text>System entscheidet bei starker Ausprägung der Kriterien.
Ungenaue Ergebnisse weist System als Grenzfall aus und erwartet manuelle Entscheidung</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_08z1w2b">
      <bpmn:text>Verringertes Nachfragen durch Kund:in</bpmn:text>
    </bpmn:textAnnotation>
